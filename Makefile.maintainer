.PHONY: help clean clean-build clean-pyc clean-test lint test docs dist bump changelog
.DEFAULT_GOAL := help

# Sphinx is not a project dependency; overlay the docs requirements (path is relative to docs/)
SPHINXBUILD := uv run --with-requirements apidocs-requirements.txt sphinx-build

help: ## list targets
	@grep -E '^[a-zA-Z_-]+:.*## ' $(MAKEFILE_LIST) | awk -F ':.*## ' '{printf "%-20s %s\n", $$1, $$2}'

clean: clean-build clean-pyc clean-test ## remove all build, test, coverage and Python artifacts

clean-build: ## remove build artifacts
	rm -fr build/
	rm -fr dist/
	rm -fr .eggs/
	find . -name '*.egg-info' -exec rm -fr {} +
	find . -name '*.egg' -exec rm -f {} +

clean-pyc: ## remove Python file artifacts
	find . -name '*.pyc' -exec rm -f {} +
	find . -name '*.pyo' -exec rm -f {} +
	find . -name '*~' -exec rm -f {} +
	find . -name '__pycache__' -exec rm -fr {} +

clean-test: ## remove test and coverage artifacts
	rm -f .coverage coverage.xml
	rm -fr htmlcov/
	rm -fr .pytest_cache

lint: ## check style with ruff
	ruff check dtw tests

test: ## run tests with the default Python
	uv run pytest

docs: ## generate Sphinx HTML documentation and open it
	rm -rf docs/api
	$(MAKE) -C docs clean SPHINXBUILD="$(SPHINXBUILD)"
	$(MAKE) -C docs html SPHINXBUILD="$(SPHINXBUILD)"
	open docs/_build/html/index.html

dist: clean ## build sdist and wheel locally (releases are built by CI)
	uv build
	ls -l dist

bump: changelog ## commit, bump patch version, push with tags
	git commit -a -m "last before bumpversion"
	uv run bump-my-version patch
	git push --tags
	git push

changelog: ## regenerate CHANGELOG.md; leaves it untouched if gitchangelog fails
	uvx gitchangelog > CHANGELOG.md.tmp
	test -s CHANGELOG.md.tmp
	mv CHANGELOG.md.tmp CHANGELOG.md
